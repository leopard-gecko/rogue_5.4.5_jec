# MSYS2 UCRT64 / MinGW-w64 - Windows native
# From the MSYS2 UCRT64 shell (the default Makefile includes this file):
#   pacman -S --needed make mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-binutils mingw-w64-ucrt-x86_64-pdcurses
#   make clean && make                # VT backend, auto: Windows UI language
#   make original                     # VT backend, original-style options
#   make PROGRAM=jrogue DEFAULT_LANGUAGE=1
#   make wizard                     # Build with the MASTER wizard features
#   make FILEDIR=saved-games        # Use the actual Saved Games known folder
#   make dist.win                   # Build and package both Windows releases
#   make dist.win PROGRAM=rogue54   # Rename the two EXEs and data files in the package
# Direct use of 'mingw32-make -f Makefile.win' remains supported for the
# standard build; FILEDIR=saved-games requires the MSYS2 UCRT64 shell.

CC = gcc
MINGW_PREFIX ?= /ucrt64
# Windows always uses the PDCursesMod VT backend.
# Reject a legacy override instead of silently producing a VT executable.
ifneq ($(origin PDC_BACKEND),undefined)
$(error PDC_BACKEND is obsolete; Windows builds always use the VT backend)
endif
# Windows icon resource, shared by the regular and original-settings builds.
WINDRES ?= windres
ICON_OBJ := windows/rogue-icon.win.o
PROG ?=
# Same executable naming interface as the macOS/Linux Makefile.
# PROGRAM takes precedence if both PROGRAM and PROG are supplied.
PROGRAM ?= $(if $(PROG),$(PROG),rogue)
DEFAULT_LANGUAGE ?= 0
FILEDIR ?=

# The optional 'saved-games' value is Windows-only shorthand for the
# current Windows user's *actual* Saved Games known-folder location, including
# locations redirected by Windows.  The build-time path is embedded in the
# executable; use the default (unset FILEDIR) for redistributable binaries.
# Query only for builds/preparation, not for housekeeping or packaging.
# MSYS2's ~/ is a POSIX directory.  Native Windows EXEs need its Windows
# absolute path, so convert the home directory with cygpath when requested.
ifneq ($(filter ~ ~/%,$(FILEDIR) $(SAVEFILE) $(SCOREFILE)),)
WIN_HOME := $(shell cygpath -m "$(HOME)" 2>/dev/null)
ifeq ($(strip $(WIN_HOME)),)
$(error Cannot resolve ~; use MSYS2 UCRT64 with HOME and cygpath)
endif
endif
expand_win_home = $(if $(filter ~,$(1)),$(WIN_HOME),$(patsubst ~/%,$(WIN_HOME)/%,$(1)))
ifeq ($(strip $(FILEDIR)),saved-games)
ifneq ($(filter-out clean dist.src dist.win,$(if $(strip $(MAKECMDGOALS)),$(MAKECMDGOALS),all)),)
SAVED_GAMES_FILEDIR := $(shell powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./windows/windows-saved-games.ps1)
ifeq ($(strip $(SAVED_GAMES_FILEDIR)),)
$(error Cannot resolve the Windows Saved Games known folder; check PowerShell and windows-saved-games.ps1)
endif
RESOLVED_FILEDIR := $(SAVED_GAMES_FILEDIR)
AUTO_PREPARE_FILEDIR := 1
endif
else
RESOLVED_FILEDIR := $(call expand_win_home,$(FILEDIR))
endif

ifneq ($(strip $(RESOLVED_FILEDIR)),)
SAVEFILE := $(RESOLVED_FILEDIR)/$(PROGRAM).save
SCOREFILE := $(RESOLVED_FILEDIR)/$(PROGRAM).scr
else
SAVEFILE := $(PROGRAM).save
SCOREFILE := $(PROGRAM).scr
endif
# Explicit command-line SAVEFILE/SCOREFILE values still take precedence.
RESOLVED_SAVEFILE := $(call expand_win_home,$(SAVEFILE))
RESOLVED_SCOREFILE := $(call expand_win_home,$(SCOREFILE))

CFILES := jec/color.c jec/unicode_text.c vers.c extern.c armor.c chase.c command.c daemon.c daemons.c fight.c init.c io.c list.c jec/language.c mach_dep.c main.c mdport.c windows/rogue_windows.c windows/rogue_windows_console.c misc.c monsters.c move.c new_level.c options.c pack.c passages.c potions.c rings.c rip.c rooms.c save.c scrolls.c state.c sticks.c things.c weapons.c wizard.c xcrypt.c
OBJS := $(CFILES:.c=.win.o)
CFLAGS ?= -O2 -g -Wall -Wextra
DEFAULT_OPTION_CPPFLAGS ?= -DMODERN_ROGUE_OPTIONS
# Keep required Windows/PDCursesMod flags even with make CPPFLAGS="...".
# Match the macOS/Linux handling of CPPFLAGS and EXTRA_CPPFLAGS.
USER_CPPFLAGS := $(CPPFLAGS)
# Quote the entire -D argument for the MSYS2 shell so paths with spaces,
# apostrophes, '$', and other shell metacharacters stay literal.  The inner
# double quotes are passed to the compiler to form C string literals.
shell_quote = '$(subst ','"'"',$(1))'
CPP_SAVEFILE := $(call shell_quote,"$(RESOLVED_SAVEFILE)")
CPP_SCOREFILE := $(call shell_quote,"$(RESOLVED_SCOREFILE)")
# MSYS2 PDCursesMod installs curses.h in <prefix>/include/pdcurses.
override CPPFLAGS := -DHAVE_CONFIG_H $(DEFAULT_OPTION_CPPFLAGS) \
                     -DPDC_WIDE=1 -DPDC_FORCE_UTF8=1 \
                     -I$(MINGW_PREFIX)/include/pdcurses -I. \
                     -DDEFAULT_SAVEFILE=$(CPP_SAVEFILE) \
                     -DSCOREFILE=$(CPP_SCOREFILE) \
                     $(if $(strip $(DEFAULT_LANGUAGE)),-DDEFAULT_LANGUAGE=$(DEFAULT_LANGUAGE)) \
                     $(USER_CPPFLAGS) $(EXTRA_CPPFLAGS)
# Match the Unix build: make MASTER=1, make master, or make wizard.
ifeq ($(MASTER),1)
override CPPFLAGS += -DMASTER
endif
LDFLAGS ?=
# Link only the VT variant of PDCursesMod.
LDLIBS := -lpdcurses_vt -lwinmm -luser32 -lgdi32 -lcomdlg32 -lshell32 -lshlwapi -ladvapi32

.PHONY: all clean japanese english original master wizard prepare-filedir dist.src dist.win
all: $(PROGRAM).exe

# Do not create anything during 'make clean', or in the default build.
# For FILEDIR=saved-games, prepare the directory as an order-only build
# prerequisite. An explicit 'make prepare-filedir FILEDIR=path' also works.
ifeq ($(AUTO_PREPARE_FILEDIR),1)
$(PROGRAM).exe: | prepare-filedir
endif
prepare-filedir:
ifeq ($(strip $(RESOLVED_FILEDIR)),)
	@echo "FILEDIR is unset; data files use the current directory."
else
ifeq ($(AUTO_PREPARE_FILEDIR),1)
	@powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./windows/windows-saved-games.ps1 -Create
else
	@mkdir -p "$$(cygpath -u "$(RESOLVED_FILEDIR)")"
endif
endif
# Embed the same multi-resolution icon in both rogue.exe and
# rogue_original.exe.  This is a Windows resource, not a Rogue C source file.
$(ICON_OBJ): windows/rogue-icon.rc windows/rogue.ico
	$(WINDRES) -I windows -i windows/rogue-icon.rc -O coff -o $@

%.win.o: %.c config.h rogue.h extern.h jec/color.h jec/language.h windows/rogue_windows.h windows/rogue_windows_console.h jec/unicode_text.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# These files include score.h; updating it must rebuild their objects.
save.win.o rip.win.o: score.h

$(PROGRAM).exe: $(OBJS) $(ICON_OBJ)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(ICON_OBJ) $(LDLIBS)
# Remove only the current build's outputs; preserve save and score files.
clean:
	rm -f $(OBJS) $(ICON_OBJ) $(PROGRAM).exe
japanese:
	$(MAKE) -f Makefile.win clean
	$(MAKE) -f Makefile.win DEFAULT_LANGUAGE=1 PROG=$(PROGRAM)
english:
	$(MAKE) -f Makefile.win clean
	$(MAKE) -f Makefile.win DEFAULT_LANGUAGE=2 PROG=$(PROGRAM)

# Original option defaults and English unless explicitly overridden.
# Only option defaults and initial language differ from the regular build.
# Clean when changing build-time defaults.
original:
	$(MAKE) -f Makefile.win clean
	$(MAKE) -f Makefile.win all DEFAULT_OPTION_CPPFLAGS= DEFAULT_LANGUAGE=$(if $(filter command line,$(origin DEFAULT_LANGUAGE)),$(DEFAULT_LANGUAGE),2)

# Like the Unix make targets, force recompilation when enabling wizard mode.
master:
	$(MAKE) -f Makefile.win clean
	$(MAKE) -f Makefile.win all MASTER=1

wizard: master

# Always use the Unix Makefile's source manifest for the archive, so MSYS2
# UCRT64 and macOS/Linux package exactly the same files.  This target does
# not build the game or remove existing binaries, objects, or saved games.
# MSYS2 provides the necessary sh, cp, mktemp, tar, gzip, and chmod tools.
dist.src:
	$(MAKE) -f Makefile ROGUE_BUILD=unix dist.src

# Redistributable Windows package.  Build both variants from clean objects
# with known defaults, irrespective of previous build options or FILEDIR.
# PROGRAM (or PROG) controls both EXE names, the shared save/score names,
# and the archive name; the regular "rogue" name retains the release name.
# Do not edit the source documents: substitute executable/data filenames only
# in the staged binary README and HTML guide copies.  MSYS2 supplies awk,
# sed and bsdtar; no additional packaging scripts are needed.
WIN_DIST_PROGRAM := $(PROGRAM)
WIN_DIST_ORIGINAL := $(WIN_DIST_PROGRAM)_original
WIN_DIST_SAVEFILE := $(WIN_DIST_PROGRAM).save
WIN_DIST_SCOREFILE := $(WIN_DIST_PROGRAM).scr
WIN_DIST_ZIP := $(if $(filter rogue,$(WIN_DIST_PROGRAM)),rogue_5.4_jec057_win.zip,$(WIN_DIST_PROGRAM)_win.zip)
WIN_DIST_DIR := Rogue 5.4

dist.win:
	@case "$(WIN_DIST_PROGRAM)" in \
	  ''|*[!A-Za-z0-9_-]*) \
	    echo "PROGRAM for dist.win must be a simple name using A-Z, a-z, 0-9, _ or -." >&2; exit 1 ;; \
	esac
	@if [ "$(MSYSTEM)" != "UCRT64" ]; then \
	  echo "make dist.win requires the MSYS2 UCRT64 shell." >&2; exit 1; \
	fi
	@command -v bsdtar >/dev/null 2>&1 || { \
	  echo "make dist.win requires bsdtar (included in MSYS2 base)." >&2; exit 1; \
	}
	$(MAKE) -f Makefile.win clean PROGRAM=$(WIN_DIST_PROGRAM) FILEDIR= MASTER=0
	$(MAKE) -f Makefile.win all PROGRAM=$(WIN_DIST_PROGRAM) FILEDIR= \
	  SAVEFILE=$(WIN_DIST_SAVEFILE) SCOREFILE=$(WIN_DIST_SCOREFILE) MASTER=0 \
	  DEFAULT_LANGUAGE=0 DEFAULT_OPTION_CPPFLAGS=-DMODERN_ROGUE_OPTIONS
	$(MAKE) -f Makefile.win clean PROGRAM=$(WIN_DIST_ORIGINAL) FILEDIR= MASTER=0
	$(MAKE) -f Makefile.win all PROGRAM=$(WIN_DIST_ORIGINAL) FILEDIR= \
	  SAVEFILE=$(WIN_DIST_SAVEFILE) SCOREFILE=$(WIN_DIST_SCOREFILE) MASTER=0 \
	  DEFAULT_LANGUAGE=2 DEFAULT_OPTION_CPPFLAGS=
	@set -eu; \
	  stage=$$(mktemp -d); \
	  trap 'rm -rf "$$stage"' EXIT HUP INT TERM; \
	  dest="$$stage/$(WIN_DIST_DIR)"; \
	  mkdir -p "$$dest"; \
	  cp $(WIN_DIST_PROGRAM).exe $(WIN_DIST_ORIGINAL).exe LICENSE.TXT "$$dest/"; \
	  for lang in ja en; do \
	    awk -v normal='$(WIN_DIST_PROGRAM).exe' \
	        -v original='$(WIN_DIST_ORIGINAL).exe' ' \
	      /^  rogue\.exe +/ { sub(/^  rogue\.exe +/, sprintf("  %-22s", normal)); } \
	      /^  rogue_original\.exe +/ { sub(/^  rogue_original\.exe +/, sprintf("  %-22s", original)); } \
	      { print; }' "windows/README_$$lang.txt" | \
	    sed -e 's/rogue_original\.exe/$(WIN_DIST_ORIGINAL).exe/g' \
	        -e 's/rogue\.exe/$(WIN_DIST_PROGRAM).exe/g' \
	        -e 's/rogue\.save/$(WIN_DIST_SAVEFILE)/g' \
	        -e 's/rogue\.scr/$(WIN_DIST_SCOREFILE)/g' \
	        > "$$dest/README_$$lang.txt"; \
	  done; \
	  sed -e 's@<pre class="prompt">rogue @<pre class="prompt">$(WIN_DIST_PROGRAM).exe @g' \
	      -e 's/rogue\.save/$(WIN_DIST_SAVEFILE)/g' \
	      rogue_ja.html > "$$dest/rogue_ja.html"; \
	  sed -e 's@% rogue save_file / % jrogue save_file@% $(WIN_DIST_PROGRAM).exe save_file / % $(WIN_DIST_ORIGINAL).exe save_file@g' \
	      -e 's@% rogue -r@% $(WIN_DIST_PROGRAM).exe -r@g' \
	      -e 's@% rogue -s@% $(WIN_DIST_PROGRAM).exe -s@g' \
	      -e 's/rogue\.save/$(WIN_DIST_SAVEFILE)/g' \
	      rogue_en.html > "$$dest/rogue_en.html"; \
	  (cd "$$stage" && bsdtar -a -cf release.zip "$(WIN_DIST_DIR)"); \
	  mv -f "$$stage/release.zip" "$(WIN_DIST_ZIP)"; \
	  printf 'Created Windows binary archive: %s/%s\n' "$(CURDIR)" "$(WIN_DIST_ZIP)"
	@rm -f $(OBJS) $(ICON_OBJ)
